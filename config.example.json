{
  "station_id": "WHD-NC",
  "listen": "127.0.0.1:8080",
  "storage": {
    "db": "data/edge.db",
    "raw_weight_journal": "data/raw-weight.jsonl",
    "event_journal": "data/events.jsonl"
  },

  "scale": {
    "adapter": "laumas-rtu",
    "serial": "COM3",
    "baud": 9600,
    "parity": "N",
    "stop_bits": 1,
    "slave": 1,
    "poll_ms": 100,
    "response_timeout_ms": 300,
    "missed_polls": 3
  },

  "io": {
    "adapter": "modbustcp",
    "addr": "192.168.10.30:502",
    "unit_id": 1,
    "map": "safety_clear=8",
    "poll_ms": 100,
    "timeout_ms": 1000
  },

  "rfid":    { "adapter": "webhook" },
  "lpr":     { "adapter": "webhook" },
  "cameras": { "adapter": "webhook", "ids": ["C1A", "C1B", "C3"] },

  "vehicles": {
    "E2001111AAAA": "61C-123.45"
  },

  "central": {
    "ticket_url": "https://central.example.invalid/api/edge/tickets",
    "heartbeat_url": "https://central.example.invalid/api/edge/heartbeat"
  }
}
